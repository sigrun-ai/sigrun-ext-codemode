{
	"name": "@sigrun/ext-codemode",
	"version": "0.1.2",
	"description": "Codemode extension for sigrun (pi-durable): the `codemode` tool — model-written JavaScript in a QuickJS sandbox, with MCP-server tools namespaced as script-callable tools",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "node scripts/check-manifest.mjs --expect-name @sigrun/ext-codemode && vitest run",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"quickjs-wasi": "3.6.2"
	},
	"peerDependencies": {
		"@earendil-works/chord": "1.3.0 || 1.4.0",
		"@earendil-works/pi-ai": "1.3.0 || 1.4.0",
		"@earendil-works/pi-codemode": "1.3.0 || 1.4.0",
		"@earendil-works/pi-durable": "1.3.0 || 1.4.0"
	},
	"devDependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-codemode": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@types/node": "^26.6.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"license": "MIT",
	"repository": {
		"type": "github",
		"url": "git+https://github.com/sigrun-ai/sigrun-ext-codemode.git"
	},
	"bugs": {
		"url": "https://github.com/sigrun-ai/sigrun-ext-codemode/issues"
	},
	"homepage": "https://github.com/sigrun-ai/sigrun-ext-codemode#readme",
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
