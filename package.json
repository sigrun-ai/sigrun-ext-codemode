{
	"name": "sigrun-ext-codemode",
	"version": "0.1.0",
	"description": "Codemode extension for sigrun (pi-durable): the `codemode` tool — model-written JavaScript in a QuickJS sandbox, with MCP-server tools namespaced as script-callable tools",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"prepare": "npm run build"
	},
	"dependencies": {
		"@earendil-works/chord": "^1.0.4",
		"@earendil-works/pi-ai": "^1.0.4",
		"@earendil-works/pi-codemode": "1.2.0",
		"@earendil-works/pi-durable": "1.2.0",
		"quickjs-wasi": "3.6.2"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}